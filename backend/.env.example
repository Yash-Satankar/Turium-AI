# gemini (default) or fake (offline, deterministic; for tests and trying the UI without a key)
PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Gemini model names change; check https://aistudio.google.com for current free-tier models.
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
# Optional: chat model tried once when the primary is rate-limited (429), overloaded (503)
# or times out, common on the free tier. Empty = no fallback.
# GEMINI_CHAT_FALLBACK_MODEL=gemini-3.8-flash
# Texts per embedding request (1-100). Smaller batches are gentler on free-tier limits.
# EMBED_BATCH_SIZE=20
# Per-request timeouts (seconds). Embedding calls use PROVIDER_TIMEOUT_S (the question embedding
# is capped at 10s); answer generation uses GEMINI_GENERATE_TIMEOUT_S. Worst-case /query is ~50s.
# PROVIDER_TIMEOUT_S=30
# GEMINI_GENERATE_TIMEOUT_S=20
# EMBEDDING_DIM=768
# MIN_SCORE=0.6
# DATABASE_PATH=data/inbox.db
# LOG_LEVEL=INFO
# FETCH_USER_AGENT=KnowledgeInbox/0.1 (+https://your-site.example)
