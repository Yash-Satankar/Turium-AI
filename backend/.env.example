# gemini (default) or fake (offline, deterministic; for tests and trying the UI without a key)
PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_CHAT_MODEL=gemini-3.8-flash
# Optional: chat model tried once when the primary is rate-limited (429) or overloaded (503),
# common on the free tier. A Flash-Lite model is a good choice. Empty = no fallback.
# GEMINI_CHAT_FALLBACK_MODEL=
# Texts per embedding request (1-100). Smaller batches are gentler on free-tier limits.
# EMBED_BATCH_SIZE=20
# EMBEDDING_DIM=768
# MIN_SCORE=0.6
# DATABASE_PATH=data/inbox.db
# LOG_LEVEL=INFO
# FETCH_USER_AGENT=KnowledgeInbox/0.1 (+https://your-site.example)
